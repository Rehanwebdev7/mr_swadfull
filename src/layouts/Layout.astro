---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import CommandMenu from '../components/CommandMenu';
import QuoteDrawer from '../components/QuoteDrawer';
import QuickViewModal from '../components/QuickViewModal';
import FloatingParticles from '../components/FloatingParticles';
import { Toaster } from 'sonner';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <Seo title={title} description={description} image={image} />
  </head>
  <body class="bg-brand-cream dark:bg-brand-green-deep text-brand-charcoal dark:text-brand-cream min-h-screen flex flex-col antialiased selection:bg-brand-gold selection:text-brand-charcoal">
    
    <!-- Floating Ambient Gold Particles -->
    <FloatingParticles client:idle />

    <!-- Site Header -->
    <Header client:load currentPath={currentPath} />

    <!-- Main Page Content -->
    <main class="flex-1 relative z-10">
      <slot />
    </main>

    <!-- Site Footer -->
    <Footer client:visible />

    <!-- Global Floating UI Components -->
    <CommandMenu client:idle />
    <QuoteDrawer client:idle />
    <QuickViewModal client:idle />

    <!-- Toast Notifications -->
    <Toaster 
      client:load 
      position="top-right" 
      toastOptions={{
        style: {
          background: '#0F382C',
          color: '#FAF6F0',
          border: '1px solid #D4A017',
          borderRadius: '16px'
        }
      }} 
    />
  </body>
</html>
