---
import Layout from '../layouts/Layout.astro';
import BrandTimeline from '../components/BrandTimeline';
import PageHeroSlider from '../components/PageHeroSlider';
import { Sparkles, Award, MapPin, Heart, ShieldCheck, ArrowRight, CheckCircle2, Leaf, Flame, Factory } from 'lucide-react';
---

<Layout
  title="Heritage & Timeline Story — Mr. Swadful Foods | Dhule Since 2011"
  description="Explore the rich heritage of Dhule's master tea blending and traditional spice milling. Discover how Mr. Swadful preserves authentic Maharashtrian taste since 2011."
>
  {/* HERITAGE HERO SLIDER BANNER */}
  <PageHeroSlider
    client:load
    badgeText="DHULE HERITAGE • FOUNDED 2011"
    title="Fourteen Years of Master Blending"
    highlightText="& Authentic Flavor"
    subtitle="From a humble local tea blender in Dhule to supplying over 2,500+ wholesale partners and millions of Indian households — discover our story of uncompromising quality and craftsmanship."
    breadcrumbs={[{ label: 'Heritage & Legacy' }]}
  />

  <div class="bg-[#FAF6F0] min-h-screen text-[#0A2920]">

    {/* INTERACTIVE TIMELINE COMPONENT */}
    <BrandTimeline client:visible />

    {/* THE CRAFTSMANSHIP & BLENDING STORY */}
    <section class="py-20 sm:py-28 bg-[#F5EFE6] border-b-2 border-[#D4A017]/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
        
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F382C] text-[#F3C649] text-xs font-black uppercase tracking-widest shadow-sm">
            <span>Our Blending Craft</span>
          </div>
          <h2 class="font-serif text-3xl sm:text-5xl font-black text-[#0A2920]">
            The Art of Sensory Tea & Spice Selection
          </h2>
          <p class="text-sm sm:text-base text-[#3E5C51] font-medium leading-relaxed">
            Behind every pack of Mr. Swadful tea and cold-ground spice lies decades of expertise in sensory tasting, elevation analysis, and traditional recipe formulation.
          </p>
        </div>

        {/* 3 COLUMNS OF CRAFT */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          {/* CRAFT 1: TEA CUPPING */}
          <div class="bg-[#FFFFFF] border-2 border-[#D4A017]/35 rounded-3xl p-8 space-y-5 shadow-lg hover:shadow-xl transition-all">
            <div className="w-12 h-12 rounded-2xl bg-[#FFF8E7] border border-[#D4A017]/40 flex items-center justify-center text-[#D4A017]">
              <Leaf class="w-6 h-6" />
            </div>
            <h3 class="font-serif text-2xl font-black text-[#0A2920]">
              Assam & Nilgiri Cupping
            </h3>
            <p class="text-xs sm:text-sm text-[#4A645A] font-medium leading-relaxed">
              Tea leaves are live botanical organisms. Our master tea tasters sample hundreds of estate lots every month from Upper Assam and Nilgiri gardens to select batches with ideal malty body and deep reddish liquor.
            </p>
            <div class="pt-2 text-xs font-bold text-[#0F382C] flex items-center gap-1.5">
              <CheckCircle2 class="w-4 h-4 text-[#D4A017]" />
              <span>100% Upper Assam CTC Granules</span>
            </div>
          </div>

          {/* CRAFT 2: SPICE MILLING */}
          <div class="bg-[#FFFFFF] border-2 border-[#D4A017]/35 rounded-3xl p-8 space-y-5 shadow-lg hover:shadow-xl transition-all">
            <div className="w-12 h-12 rounded-2xl bg-[#FFF8E7] border border-[#D4A017]/40 flex items-center justify-center text-[#D4A017]">
              <Flame class="w-6 h-6" />
            </div>
            <h3 class="font-serif text-2xl font-black text-[#0A2920]">
              Hygienic Cold Stone Milling
            </h3>
            <p class="text-xs sm:text-sm text-[#4A645A] font-medium leading-relaxed">
              High-speed milling destroys natural essential oils. We use traditional temperature-controlled stone mills that preserve natural curcumin in turmeric, volatile capsaicin in chilli, and floral aroma in cardamom.
            </p>
            <div class="pt-2 text-xs font-bold text-[#0F382C] flex items-center gap-1.5">
              <CheckCircle2 class="w-4 h-4 text-[#D4A017]" />
              <span>Zero Added Artificial Colors</span>
            </div>
          </div>

          {/* CRAFT 3: HANDCRAFTED PAPAD */}
          <div class="bg-[#FFFFFF] border-2 border-[#D4A017]/35 rounded-3xl p-8 space-y-5 shadow-lg hover:shadow-xl transition-all">
            <div className="w-12 h-12 rounded-2xl bg-[#FFF8E7] border border-[#D4A017]/40 flex items-center justify-center text-[#D4A017]">
              <Factory class="w-6 h-6" />
            </div>
            <h3 class="font-serif text-2xl font-black text-[#0A2920]">
              Traditional Urad Papad Roll
            </h3>
            <p class="text-xs sm:text-sm text-[#4A645A] font-medium leading-relaxed">
              Hand-rolled in small batches using premium Urad dal flour, pure Sajji khar, hing (asafoetida), and coarsely crushed black pepper. Puffs up ultra-light and crisp with zero oiliness.
            </p>
            <div class="pt-2 text-xs font-bold text-[#0F382C] flex items-center gap-1.5">
              <CheckCircle2 class="w-4 h-4 text-[#D4A017]" />
              <span>Traditional Dhule Recipe</span>
            </div>
          </div>

        </div>

      </div>
    </section>

    {/* BRAND VALUES & PROMISE SECTION */}
    <section class="py-20 sm:py-28 bg-[#FAF6F0]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-[#0A2920] border-2 border-[#D4A017]/40 rounded-3xl p-8 sm:p-14 text-white shadow-2xl relative overflow-hidden">
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center relative z-10">
            <div class="space-y-6">
              <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 text-[#F3C649] text-xs font-bold uppercase tracking-widest border border-white/20">
                The Swadful Promise
              </div>
              <h2 class="font-serif text-3xl sm:text-5xl font-black text-white leading-tight">
                Authentic Maharashtrian Flavor in Every Household
              </h2>
              <p class="text-sm sm:text-base text-[#C1D4CD] leading-relaxed font-medium">
                We take immense pride in our Dhule roots. Whether supplying daily tea stalls across cities or supplying household kitchens, our commitment remains identical: 100% purity, direct estate sourcing, and unbeatable wholesale pricing.
              </p>
              
              <div class="pt-4 flex flex-wrap gap-4">
                <a
                  href="/products"
                  class="px-8 py-4 rounded-2xl bg-gradient-to-r from-[#D4A017] to-[#F3C649] text-[#0A2920] font-black text-xs uppercase tracking-wider hover:scale-105 transition-all shadow-xl flex items-center gap-2"
                >
                  <span>Explore Catalogue</span>
                  <ArrowRight class="w-4 h-4" />
                </a>

                <a
                  href="/wholesale"
                  class="px-8 py-4 rounded-2xl bg-white/10 border-2 border-[#D4A017] text-white font-bold text-xs uppercase tracking-wider hover:bg-[#D4A017]/20 transition-all flex items-center gap-2"
                >
                  <span>B2B Wholesale Inquiry</span>
                </a>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4 text-xs font-bold">
              <div class="p-5 rounded-2xl bg-white/5 border border-white/15 space-y-2">
                <div class="text-[#F3C649] text-2xl font-black font-serif">2011</div>
                <div class="text-white text-sm">Established in Dhule</div>
                <p class="text-[#C1D4CD] text-xs font-normal">Over 15 years of uninterrupted culinary trust.</p>
              </div>

              <div class="p-5 rounded-2xl bg-white/5 border border-white/15 space-y-2">
                <div class="text-[#F3C649] text-2xl font-black font-serif">2,500+</div>
                <div class="text-white text-sm">B2B Partners</div>
                <p class="text-[#C1D4CD] text-xs font-normal">Trusted by hotels, caterers & distributors.</p>
              </div>

              <div class="p-5 rounded-2xl bg-white/5 border border-white/15 space-y-2">
                <div class="text-[#F3C649] text-2xl font-black font-serif">10 T+</div>
                <div class="text-white text-sm">Daily Capacity</div>
                <p class="text-[#C1D4CD] text-xs font-normal">Hygienic processing & vacuum packaging.</p>
              </div>

              <div class="p-5 rounded-2xl bg-white/5 border border-white/15 space-y-2">
                <div class="text-[#F3C649] text-2xl font-black font-serif">18 Points</div>
                <div class="text-white text-sm">Quality Batch Testing</div>
                <p class="text-[#C1D4CD] text-xs font-normal">Strict FSSAI & ISO standard checks.</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

  </div>
</Layout>
