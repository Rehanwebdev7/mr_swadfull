---
import Layout from '../layouts/Layout.astro';
import PageHeroSlider from '../components/PageHeroSlider';
import { COMPANY_INFO } from '../data/products';
import { MapPin, Phone, Mail, Clock, Send, Sparkles, MessageSquare } from 'lucide-react';
---

<Layout
  title="Contact Us — Dhule Factory & Sales | Mr. Swadful Foods"
  description="Get in touch with Mr. Swadful Foods in Dhule, Maharashtra. Call +91 99756 09708 or visit our factory at Plot no. 76, Vadjai Rd, Vaibhav Nagar, Dhule."
>
  {/* HERO SLIDER BANNER AT TOP */}
  <PageHeroSlider
    client:load
    badgeText="GET IN TOUCH WITH US"
    title="Visit Our Factory or"
    highlightText="Talk to Sales"
    subtitle="Have a question about our tea blends, spice orders, or wholesale agency in your city? Reach out to our Dhule office today."
    breadcrumbs={[{ label: 'Contact Us' }]}
  />

  <div class="py-12 sm:py-20 bg-[#FAF6F0] min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        {/* Contact Cards */}
        <div class="lg:col-span-5 space-y-6">
          
          <div class="p-6 rounded-3xl bg-[#0F382C] text-white border-2 border-[#D4A017]/40 shadow-xl space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-[#F3C649]">
                <MapPin class="w-5 h-5" />
              </div>
              <div>
                <h3 class="font-serif text-lg font-bold text-[#F3C649]">Factory & Office Address</h3>
                <p class="text-xs text-[#D1E0D9]">Dhule Manufacturing Unit</p>
              </div>
            </div>
            <p class="text-xs text-[#D1E0D9] leading-relaxed pt-2 border-t border-white/10">
              {COMPANY_INFO.address.line1}, {COMPANY_INFO.address.line2}, {COMPANY_INFO.address.city}, {COMPANY_INFO.address.state} - {COMPANY_INFO.address.pincode}
            </p>
          </div>

          <div class="p-6 rounded-3xl bg-[#0F382C] text-white border-2 border-[#D4A017]/40 shadow-xl space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-[#F3C649]">
                <Phone class="w-5 h-5" />
              </div>
              <div>
                <h3 class="font-serif text-lg font-bold text-[#F3C649]">Direct Support Numbers</h3>
                <p class="text-xs text-[#D1E0D9]">Monday – Saturday (9AM – 7PM)</p>
              </div>
            </div>
            <div class="space-y-1.5 text-xs text-[#D1E0D9] pt-2 border-t border-white/10 font-semibold">
              <div>Primary: <a href={`tel:${COMPANY_INFO.contact.phonePrimary}`} class="text-[#F3C649] hover:underline">{COMPANY_INFO.contact.phonePrimary}</a></div>
              <div>Secondary: <a href={`tel:${COMPANY_INFO.contact.phoneSecondary}`} class="text-[#F3C649] hover:underline">{COMPANY_INFO.contact.phoneSecondary}</a></div>
              <div>Email: <a href={`mailto:${COMPANY_INFO.contact.email}`} class="text-[#F3C649] hover:underline">{COMPANY_INFO.contact.email}</a></div>
            </div>
          </div>

          {/* Quick WhatsApp Connect */}
          <a
            href={`https://wa.me/${COMPANY_INFO.contact.whatsapp}?text=Hello%20Mr.%20Swadful%20Team,%20I%20want%20to%20inquire%20about%20products.`}
            target="_blank"
            rel="noreferrer"
            class="flex items-center justify-center gap-3 p-4 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl transition-all hover:scale-105"
          >
            <MessageSquare class="w-5 h-5" />
            <span>Chat Directly on WhatsApp</span>
          </a>

        </div>

        {/* Interactive Google Map Embed */}
        <div class="lg:col-span-7 bg-[#0F382C] rounded-3xl p-4 border-2 border-[#D4A017]/40 shadow-2xl overflow-hidden">
          <div class="w-full h-[420px] rounded-2xl overflow-hidden border border-white/20">
            <iframe
              src="https://www.google.com/maps?q=Dhule,+Maharashtra&output=embed"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>

      </div>

    </div>
  </div>
</Layout>
