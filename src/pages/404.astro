---
import Layout from '../layouts/Layout.astro';
import { Coffee, ArrowLeft } from 'lucide-react';
---

<Layout title="Page Not Found | Mr. Swadful Foods">
  <div class="py-24 bg-brand-cream dark:bg-brand-green-deep text-center min-h-[70vh] flex items-center justify-center">
    <div class="max-w-md mx-auto space-y-6 px-4">
      <div class="w-20 h-20 rounded-full bg-brand-gold/20 border border-brand-gold/40 flex items-center justify-center mx-auto text-brand-gold">
        <Coffee class="w-10 h-10" />
      </div>
      <h1 class="font-serif text-5xl font-extrabold text-brand-gold">404</h1>
      <h2 class="font-serif text-2xl font-bold text-brand-main dark:text-brand-cream">
        Oops! Page Not Found
      </h2>
      <p class="text-xs text-brand-muted dark:text-brand-cream/70 leading-relaxed">
        The page you are looking for might have been moved or doesn't exist. Take a warm cup of chai and head back to our homepage!
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-brand-gold text-brand-charcoal font-bold text-xs uppercase tracking-wider hover:scale-105 transition-all shadow-lg"
      >
        <ArrowLeft class="w-4 h-4" />
        <span>Return to Homepage</span>
      </a>
    </div>
  </div>
</Layout>
